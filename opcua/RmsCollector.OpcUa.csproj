<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rms_collector_opcua</AssemblyName>
    <RootNamespace>RmsCollector</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.378.196" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Configuration" Version="1.5.378.196" />
    <Compile Include="../src-csharp/*.cs" Exclude="../src-csharp/Program.cs;../src-csharp/Transport.cs;../src-csharp/AssemblyInfo.cs" />
    <Reference Include="YMConnect_CS">
      <HintPath>../sdk/dotnet/YMConnect_CS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="../sdk/dotnet/YMConnect.dll" Link="YMConnect.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../sdk/dotnet/LICENSE" Link="licenses/YMConnect-LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Update="licenses/**" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../config/collector.opcua.conf;../config/robots.opcua.conf" Link="config/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../PANDUAN_IGNITION_OPCUA.md" Link="PANDUAN_IGNITION_OPCUA.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../RINGKASAN_PERUBAHAN_OPCUA.md" Link="RINGKASAN_PERUBAHAN_OPCUA.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../deploy/windows/*OPCUA.cmd" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckVendorSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('../sdk/dotnet/YMConnect_CS.dll') Or !Exists('../sdk/dotnet/YMConnect.dll')" Text="Keep the official matching YMConnect_CS.dll and YMConnect.dll in sdk/dotnet." />
  </Target>
</Project>
